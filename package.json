{
  "name": "mixgenres",
  "description": "Build a song in one of dozens of musical genres, then rework its parts, chords, rhythms and instruments and export it as an MP3. Runs entirely in your browser.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build:static": "vite build",
    "predeploy": "npm run build:static",
    "deploy": "gh-pages -d dist",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "build": "npm run check && vite build",
    "check": "tsc --noEmit && npm run check:data-boundary && npm run check:ids",
    "check:data-boundary": "node scripts/checks/data-boundary.mjs",
    "check:ids": "node --import tsx scripts/checks/data-ids.ts",
    "check:catalog-expansion": "node --import tsx scripts/checks/catalog-expansion.ts",
    "check:catalog-static": "python3 scripts/checks/catalog-static.py",
    "check:smoke": "node --import tsx scripts/checks/smoke-compile.ts",
    "check:styles": "node --import tsx scripts/checks/styles.ts",
    "check:instruments": "node --import tsx scripts/checks/instruments.ts",
    "check:instrument-render": "node --import tsx scripts/checks/instrument-render.ts",
    "check:markers": "node --import tsx scripts/checks/source-markers.ts",
    "check:rigorous": "npm run check && npm run check:instruments && npm run check:instrument-render && npm run test:audio",
    "test": "npm run check && npm run check:smoke && npm run test:integrity",
    "test:integrity": "node --import tsx scripts/checks/styles.ts --only=compile",
    "test:unit": "node --import tsx --test scripts/checks/unit/engine-behavior.test.mjs && node --import tsx scripts/checks/unit/engine-arrangement.test.ts",
    "test:audio": "node --import tsx scripts/render/regression.ts",
    "test:all": "npm run test && npm run test:audio && npm run build:static",
    "report:levels": "node --import tsx scripts/reports/style-levels.ts",
    "report:level-targets": "python3 scripts/reports/level-targets-diff.py",
    "report:genres": "node --import tsx scripts/reports/genre-baseline.ts",
    "report:sonic-model": "node --import tsx scripts/reports/song-sonic-model.ts",
    "report:instrument-schema": "node --import tsx scripts/reports/instrument-schema.ts",
    "generate:catalog": "node --import tsx scripts/generate/catalog-schemas.ts",
    "render:song": "node --import tsx scripts/render/song.ts",
    "render:styles": "node --import tsx scripts/render/styles.ts",
    "render:expansion": "node --import tsx scripts/render/styles.ts --set=expansion",
    "render:instrument": "node --import tsx scripts/render/instrument.ts",
    "render:regression": "node --import tsx scripts/render/regression.ts",
    "render:stems": "node --import tsx scripts/render/stems.ts",
    "check:tsc": "tsc --noEmit",
    "audit:run": "node --import tsx scripts/audit/run.ts",
    "audit:browser": "node scripts/audit/browser-master.mjs",
    "audit:diff": "node --import tsx scripts/audit/diff.ts",
    "card:diff": "node --import tsx scripts/audit/card-diff.ts",
    "check:data-reach": "node --import tsx scripts/checks/data-reach.ts",
    "check:symbolic": "node --import tsx scripts/checks/symbolic-audit.ts",
    "check:audio": "node --import tsx scripts/checks/audio-audit.ts",
    "audit:style": "node --import tsx scripts/audit/style-audit.ts",
    "report:song-card": "node --import tsx scripts/reports/song-card.ts",
    "render:stems-analyze": "python3 scripts/render/stems-analyze.py",
    "migrate:consolidate-genres": "python3 scripts/migrations/consolidate-genre-files.py"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@elemaudio/core": "^4.0.1",
    "@elemaudio/offline-renderer": "^4.0.3",
    "@elemaudio/web-renderer": "^4.0.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2"
  }
}
