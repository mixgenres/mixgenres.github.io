{
  "name": "mixgenres",
  "description": "Build a song in one of dozens of musical genres, then rework its parts, chords, rhythms and instruments and export it as an MP3. Runs entirely in your browser.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "npm run lint && npm run check && vite build",
    "build:static": "vite build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && npm run audit:api",
    "check": "node --import tsx scripts/check-system.ts",
    "test": "npm run check",
    "render-song": "node --import tsx scripts/render-song.ts",
    "test:audio": "node --import tsx scripts/audio-regression-harness.ts",
    "test:all": "npm run lint && npm run check:audio && npm run build:static",
    "audit:data-boundary": "node scripts/audit-data-boundary.mjs",
    "test:solos": "node --import tsx scripts/solo-performance.test.ts",
    "test:sound-metadata": "node --import tsx scripts/sound-metadata.test.ts",
    "test:exports": "node --import tsx scripts/export.test.ts",
    "check:audio": "node --import tsx scripts/check-system.ts --audio",
    "check:full": "npm run check:audio",
    "audit:report": "node --import tsx scripts/check-system.ts --report-only",
    "test:mix": "node --import tsx --test scripts/mix-regression.test.ts scripts/dynamic-mix.test.ts",
    "audit:browser": "node --import tsx scripts/browser-audit-server.ts",
    "audit:catalog": "node --import tsx scripts/audit-catalog.ts",
    "audit:examples": "node --import tsx scripts/audit-examples.ts",
    "audit:song-patterns": "node --import tsx scripts/audit-song-pattern-diversity.ts",
    "audit:sample-ensembles": "node --import tsx scripts/audit-sample-song-ensembles.ts",
    "audit:accuracy": "node --import tsx scripts/audit-song-accuracy.ts --scores",
    "test:accuracy": "node --import tsx --test scripts/song-accuracy.test.ts",
    "test:score": "node --import tsx --test scripts/musician-score.test.ts scripts/engine-pipeline.test.ts",
    "audit:audio-catalog": "node --import tsx scripts/audio-regression-harness.ts --all-styles",
    "audit:api": "node --import tsx scripts/audit-api-usage.ts",
    "test:soundfont": "node --import tsx --test --test-concurrency=1 scripts/soundfont-playback.test.ts scripts/soundfont-transport.test.ts scripts/mp3-streaming.test.ts",
    "soundfonts:package": "node --import tsx scripts/package-soundfonts.ts",
    "audit:soundfont": "node --import tsx scripts/soundfont-audit-server.ts",
    "benchmark:soundfont": "node --import tsx scripts/benchmark-soundfont.ts"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "spessasynth_core": "4.3.22",
    "stb-vorbis": "0.0.6",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2"
  }
}
