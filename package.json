{
  "name": "mixgenres",
  "description": "Build a song in one of dozens of musical genres, then rework its parts, chords, rhythms and instruments and export it as an MP3. Runs entirely in your browser.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "npm run calibrate && npm run check && vite build",
    "calibrate": "tsx scripts/gain-calibration.ts --apply",
    "build:static": "vite build",
    "predeploy": "npm run build:static",
    "deploy": "gh-pages -d dist",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "check": "tsc --noEmit && npm run audit:data-boundary && npm run audit:ids",
    "test": "npm run check && node --import tsx scripts/test-filter.ts && node --import tsx scripts/engine-integrity-audit.ts",
    "render-song": "tsx scripts/render-song.ts",
    "gain-calibration": "tsx scripts/gain-calibration.ts",
    "audit:genre-dialects": "tsx scripts/audit-genre-dialects.ts",
    "test:audio": "node --import tsx scripts/audio-regression-harness.ts",
    "test:all": "npm run test && npm run test:audio && npm run build:static",
    "audit:mp3": "tsx scripts/audio-regression-harness.ts",
    "audit:instruments": "tsx scripts/audit-instrument-authenticity.ts",
    "audit:instrument-render": "tsx scripts/audit-instrument-render.ts",
    "render:instrument": "tsx scripts/render-instrument.ts",
    "test:integrity": "tsx scripts/engine-integrity-audit.ts",
    "audit:styles": "tsx scripts/audit-all-styles.ts",
    "audit:performance": "tsx scripts/audit-style-performance.ts",
    "audit:tone": "node --import tsx scripts/audit-style-tone.ts",
    "render:all-styles": "tsx scripts/render-all-styles.ts",
    "audit:paths": "tsx scripts/audit-instrument-paths.ts",
    "schema:render": "tsx scripts/pre-render-schema.ts",
    "schema:catalog": "node --import tsx scripts/generate-catalog-schemas.ts",
    "audit:rigorous": "npm run check && npm run audit:paths && npm run audit:instruments && npm run audit:instrument-render && npm run test:audio",
    "audit:data-boundary": "node scripts/audit-data-boundary.mjs",
    "audit:ids": "node --import tsx scripts/audit-data-ids.ts",
    "audit:catalog-expansion": "tsx scripts/audit-catalog-expansion.ts",
    "render:catalog-expansion": "tsx scripts/render-catalog-expansion.ts"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@elemaudio/core": "^4.0.1",
    "@elemaudio/offline-renderer": "^4.0.3",
    "@elemaudio/web-renderer": "^4.0.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2"
  }
}
